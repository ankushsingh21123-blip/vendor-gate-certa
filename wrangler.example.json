{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vendor-gate-certa",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "vendor-gate-certa",
    "database_id": "REPLACE_ONLY_WITH_NEW_DEDICATED_DATABASE_ID"
  }]
}
